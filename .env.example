# ================================================================
# Student Success & Intervention Engine (SS&IE) Environment Config
# ================================================================
# Copy this file to '.env' and update the values as needed:
#   cp .env.example .env
#
# DO NOT commit your real '.env' file with production credentials.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Security Settings
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Data Storage
CSV_DATA_PATH=students_data.csv
